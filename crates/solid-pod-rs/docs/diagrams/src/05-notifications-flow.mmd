  'edgeLabelBackground':'#0f172a','fontFamily':'ui-sans-serif, system-ui, sans-serif'
}}}%%
flowchart LR
  %% ─── Source ───
  subgraph SRC["Storage layer (trait Storage)"]
    EV["StorageEvent::{Created | Updated | Deleted}(path)"]:::store
  end

  %% ─── Fan-out ───
  BCAST{{"tokio::sync::broadcast<br/>ChangeNotification channel"}}:::gate
  EV --> |pump_from_storage| BCAST

  %% ─── WebSocket side ───
  subgraph WS["WebSocketChannelManager"]
    direction TB
    WSSUB1["Subscription #1<br/>(broadcast::Receiver)<br/>topic = /alice/notes/"]:::svc
    WSSUB2["Subscription #2<br/>(broadcast::Receiver)<br/>topic = /alice/"]:::svc
    WSHB["heartbeat: Duration<br/>(default 30 s)"]:::svc
  end
  BCAST -->|"fan-out recv()"| WSSUB1
  BCAST -->|"fan-out recv()"| WSSUB2

  %% ─── Webhook side ───
  subgraph WH["WebhookChannelManager"]
    direction TB
    WHDISP["deliver_one / deliver_all<br/>(reqwest::Client)"]:::svc
    WHRETRY["Full-jitter exponential backoff<br/>base 500 ms × 2^attempt, cap 1 h<br/>max 3 retries on 5xx<br/>429 honours Retry-After"]:::gate
  end
  BCAST -->|pump_from_storage| WHDISP
  WHDISP --> WHRETRY

  %% ─── Consumers ───
  WSC["WebSocket client<br/>(Authorization: DPoP / NIP-98)"]:::gov
  WEBHOOK["Target URL<br/>POST application/ld+json"]:::gov

  WSSUB1 --> WSC
  WSSUB2 --> WSC
  WHRETRY -->|HTTP 2xx| WEBHOOK
  WHRETRY -.persistent failure.-> WHDEAD[["Circuit breaker opens after 10<br/>consecutive failures →<br/>short-circuits to TransientRetry<br/>until a delivery succeeds"]]:::deny

  %% ─── Payload envelope ───
  ENV["AS 2.0 ChangeNotification envelope:<br/>{<br/>  '@context': 'https://www.w3.org/ns/<br/>activitystreams',<br/>  'id': 'urn:uuid:…',<br/>  'type': 'Create' | 'Update' | 'Delete',<br/>  'object': '&lt;pod-base&gt;/alice/notes/foo.ttl',<br/>  'published': '2026-04-20T10:12:30Z'<br/>}"]:::gov

  BCAST -.serialises as.-> ENV

