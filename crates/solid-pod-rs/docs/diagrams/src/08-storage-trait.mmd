}}}%%
classDiagram
  direction TB

  class Storage {
    <<trait>>
    +async get(path) Result~(Bytes, ResourceMeta), PodError~
    +async put(path, body, content_type) Result~ResourceMeta, PodError~
    +async delete(path) Result~(), PodError~
    +async list(container) Result~Vec~String~, PodError~
    +async head(path) Result~ResourceMeta, PodError~
    +async exists(path) Result~bool, PodError~
    +async create_container(path) Result~ResourceMeta, PodError~
    +async watch(path) Result~Receiver~StorageEvent~, PodError~
  }

  class ResourceMeta {
    +etag: String
    +modified: DateTime~Utc~
    +size: u64
    +content_type: String
    +links: Vec~String~
  }

  class StorageEvent {
    <<enum>>
    Created(path)
    Updated(path)
    Deleted(path)
  }

  class FsBackend {
    <<feature: fs-backend>>
    -root: PathBuf
    +new(root) Self
  }

  class MemoryBackend {
    <<feature: memory-backend>>
    -data: RwLock~HashMap~
    -events: broadcast::Sender~StorageEvent~
    +new() Self
  }

  Storage <|.. FsBackend          : impl
  Storage <|.. MemoryBackend      : impl

  Storage ..> ResourceMeta        : returns
  Storage ..> StorageEvent        : emits via watch()

  note for Storage "The `s3-backend` feature flag is declared\n(pulls aws-sdk-s3) but no S3/R2 backend\nimplementation ships as of 2026-06-12 —\nFsBackend and MemoryBackend are the\nonly impls."
  note for FsBackend "Uses notify(6) for watch();\nplain fs::write + .meta JSON sidecar\n(no atomic rename-on-put)."
  note for MemoryBackend "In-process RwLock store;\nintended for tests + examples."
