  'primaryColor':'#0f172a','primaryTextColor':'#E8F4FC','primaryBorderColor':'#E8F4FC',
  'lineColor':'#E8F4FC','secondaryColor':'#0f172a','tertiaryColor':'#0f172a',
  'background':'transparent','mainBkg':'#0f172a','clusterBkg':'#0f172a','clusterBorder':'#E8F4FC',
  'edgeLabelBackground':'#0f172a','fontFamily':'ui-sans-serif, system-ui, sans-serif'
}}}%%
flowchart TB
  %% ───── HTTP LAYER ─────
  subgraph HTTP["HTTP Layer — actix-web handlers"]
    direction LR
    H_GET["GET /{path}"]:::svc
    H_PUT["PUT /{path}"]:::svc
    H_POST["POST /{container}/"]:::svc
    H_PATCH["PATCH /{path}"]:::svc
    H_DEL["DELETE /{path}"]:::svc
    H_WS["GET /.notifications&nbsp;(WS)<br/>(advertised via Updates-Via;<br/>WS endpoint is host-wired,<br/>not mounted by the bundled server)"]:::svc
  end

  %% ───── AUTH GATE ─────
  subgraph AUTH["Auth Gate (governance)"]
    direction LR
    NIP98["NIP-98 verify<br/>(auth::nip98)"]:::gov
    OIDC["Solid-OIDC + DPoP<br/>(oidc feature — library lane<br/>for embedders; not wired in the<br/>bundled server as of 2026-06-12)"]:::gov
  end

  %% ───── SERVICE LAYER ─────
  subgraph SVC["Service Layer"]
    direction LR
    LDP["ldp module<br/>(ldp.rs)<br/>containers · RDF · PATCH"]:::svc
    WAC["wac::evaluate_access_ctx<br/>(wac/)<br/>StorageAclResolver walk-up"]:::gate
    NOTIF["WebSocketChannelManager +<br/>WebhookChannelManager<br/>(notifications/)"]:::svc
    WEBID["WebID profiles<br/>(webid.rs)"]:::svc
  end

  %% ───── STORAGE LAYER ─────
  subgraph STORE["Storage Layer — trait Storage"]
    direction LR
    FS["FsBackend<br/>(storage::fs)"]:::store
    MEM["MemoryBackend<br/>(storage::memory)"]:::store
    Custom["Consumer-owned Storage impl<br/>(not configured by bundled server)"]:::storeOpt
  end

  %% ───── FLOW ─────
  H_GET --> NIP98
  H_PUT --> NIP98
  H_POST --> NIP98
  H_PATCH --> NIP98
  H_DEL --> NIP98
  H_WS --> NIP98
  NIP98 -.library alt.-> OIDC

  AUTH --> WAC
  WAC -->|allow| LDP
  WAC -.deny.-> DENY[["401 / 403 + WAC-Allow"]]:::deny

  LDP --> WEBID
  LDP --> STORE
  LDP -->|StorageEvent| NOTIF
  NOTIF --> H_WS

  classDef gov fill:#8B5CF6,stroke:#E8F4FC,stroke-width:1px,color:#E8F4FC
  classDef gate fill:#F59E0B,stroke:#E8F4FC,stroke-width:1px,color:#0f172a
  classDef svc fill:#00D4FF,stroke:#E8F4FC,stroke-width:1px,color:#0f172a
  classDef store fill:#10B981,stroke:#E8F4FC,stroke-width:1px,color:#0f172a
  classDef storeOpt fill:#10B981,stroke:#E8F4FC,stroke-width:1px,color:#0f172a,stroke-dasharray: 4 3
  classDef deny fill:#EF4444,stroke:#E8F4FC,stroke-width:1px,color:#E8F4FC
