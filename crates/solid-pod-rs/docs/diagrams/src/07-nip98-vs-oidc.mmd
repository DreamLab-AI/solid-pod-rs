flowchart TB
  REQ(["Incoming HTTP request\nGET/PUT/POST/PATCH/DELETE /{path}"]):::entry

  PICK{{"Authorization scheme?"}}:::gate

  %% ─── NIP-98 lane ───
  subgraph NIP["NIP-98 (Nostr) lane — auth::nip98 (wired in solid-pod-rs-server)"]
    direction TB
    N1["Header: Authorization: Nostr &lt;b64(Nip98Event)&gt;"]:::gov
    N2["Decode Nip98Event (64 KB cap):\n  kind MUST be 27235\n  tags: [u, method, payload]\n  pubkey, sig"]:::svc
    N3["Freshness window: |now − created_at| ≤ 60 s"]:::gate
    N4["URL + method match:\n  MatchPolicy::Strict (default, exact)\n  MatchPolicy::GitLenient (git lane:\n  prefix URL, method '*')"]:::gate
    N5["Body-hash binding (when body supplied):\n  sha256(body) == tag 'payload'"]:::gate
    N6["Schnorr sig verify over serialised event\n(feature-gated: nip98-schnorr;\nstructural checks only without it)"]:::gate
    N7["agent_uri = did:nostr:&lt;pubkey&gt;"]:::gov
  end

  %% ─── OIDC lane ───
  subgraph OID["Solid-OIDC + DPoP lane — oidc feature (library lane for embedders;\nNOT wired into the bundled solid-pod-rs-server as of 2026-06-12)"]
    direction TB
    O1["Header: Authorization: DPoP &lt;access_token&gt;\n          DPoP: &lt;proof&gt;"]:::gov
    O2["verify_dpop_proof_with_ath(proof, htu, htm, …)"]:::gate
    O3["verify_access_token(token) → SolidOidcClaims"]:::svc
    O4["claims.cnf.jkt == thumbprint(proof.jwk)"]:::gate
    O5["ath claim == SHA-256(access_token)\n(when expected_ath supplied)"]:::gate
    O6["extract_webid(claims) → WebID IRI"]:::gov
  end

  MERGE(["Agent URI established"]):::entry
  WAC["WAC evaluation\n(wac::evaluate_access_ctx)"]:::gate
  ALLOW(["→ LDP / storage"]):::allow
  DENY(["401 / 403 + WAC-Allow"]):::deny

  REQ --> PICK
  PICK -->|Nostr …| NIP
  PICK -->|DPoP …| OID
  PICK -.->|"neither → anonymous, foaf:Agent rules only"| WAC

  N2 --> N3 --> N4 --> N5 --> N6 --> N7 --> MERGE
  O1 --> O2 --> O3 --> O4 --> O5 --> O6 --> MERGE

  MERGE --> WAC
  WAC -->|allow| ALLOW
  WAC -.deny.-> DENY

  classDef entry fill:#00D4FF,stroke:#E8F4FC,stroke-width:1px,color:#0f172a
  classDef gov fill:#8B5CF6,stroke:#E8F4FC,stroke-width:1px,color:#E8F4FC
  classDef gate fill:#F59E0B,stroke:#E8F4FC,stroke-width:1px,color:#0f172a
  classDef svc fill:#00D4FF,stroke:#E8F4FC,stroke-width:1px,color:#0f172a
  classDef allow fill:#10B981,stroke:#E8F4FC,stroke-width:1px,color:#0f172a
  classDef deny fill:#EF4444,stroke:#E8F4FC,stroke-width:1px,color:#E8F4FC
